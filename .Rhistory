# from Gemini translation of Python code
library(stabledist)
# Define parameters for Z (standard stable distribution)
alpha <- 1.9  # Tail exponent
beta <- 0.0   # Skewness (symmetric)
sigma <- 1.0   # Scale
delta <- 0.0   # Location
# Define parameters for W1
beta1 <- 0.1
sigma1 <- 0.8
delta1 <- 1.3
sigma2 <- (sigma^alpha - sigma1^alpha)^(1/alpha)
beta2 <- (beta * (sigma^alpha) - beta1 * (sigma1^alpha)) / (sigma2^alpha) # Corrected calculation for beta2
delta2 <- delta - delta1
# Print the calculated parameters for W2
cat("beta:", beta, "beta1:", beta1, "beta2:", beta2, "sigma2:", sigma2, "delta2:", delta2, "\n")
# Z ~ S(alpha, beta, sigma, delta; 1)
fz_cdf <- function(x) pstable(x, alpha, beta, sigma, delta, pm = 1)
fz_pdf <- function(x) dstable(x, alpha, beta, sigma, delta, pm = 1)
# W1 ~ S(alpha, beta1, sigma1, delta1; 1)
fw1_cdf <- function(x) pstable(x, alpha, beta1, sigma1, delta1, pm = 1)
fw1_pdf <- function(x) dstable(x, alpha, beta1, sigma1, delta1, pm = 1)
# W2 ~ S(alpha, beta2, sigma2, delta2; 1)
fw2_cdf <- function(x) pstable(x, alpha, beta2, sigma2, delta2, pm = 1)
fw2_pdf <- function(x) dstable(x, alpha, beta2, sigma2, delta2, pm = 1)
# Define the function to be integrated
f <- function(x) {
fz_cdf(x) * fw1_pdf(x)
}
# Perform the numerical integration using integrate()
integration_result <- integrate(f, -Inf, Inf)
integration_result
# Print the integration result and the CDF of W2 at 0
cat("Integration Result:", integration_result$value, "\n")
cat("CDF of W2 at 0:", fw2_cdf(0), "\n")
# Verification: These should ideally be very close
cat("Difference:", integration_result$value-fw2_cdf(0) )
beta2 <- -beta1 * (sigma1 / sigma2)^alpha
#beta2 <- (beta * (sigma^alpha) - beta1 * (sigma1^alpha)) / (sigma2^alpha) # Corrected calculation for beta2
delta2 <- delta - delta1
# Print the calculated parameters for W2
cat("beta:", beta, "beta1:", beta1, "beta2:", beta2, "sigma2:", sigma2, "delta2:", delta2, "\n")
# Z ~ S(alpha, beta, sigma, delta; 1)
fz_cdf <- function(x) pstable(x, alpha, beta, sigma, delta, pm = 1)
fz_pdf <- function(x) dstable(x, alpha, beta, sigma, delta, pm = 1)
# W1 ~ S(alpha, beta1, sigma1, delta1; 1)
fw1_cdf <- function(x) pstable(x, alpha, beta1, sigma1, delta1, pm = 1)
fw1_pdf <- function(x) dstable(x, alpha, beta1, sigma1, delta1, pm = 1)
# W2 ~ S(alpha, beta2, sigma2, delta2; 1)
fw2_cdf <- function(x) pstable(x, alpha, beta2, sigma2, delta2, pm = 1)
fw2_pdf <- function(x) dstable(x, alpha, beta2, sigma2, delta2, pm = 1)
# Define the function to be integrated
f <- function(x) {
fz_cdf(x) * fw1_pdf(x)
}
# Perform the numerical integration using integrate()
integration_result <- integrate(f, -Inf, Inf)
# Print the integration result and the CDF of W2 at 0
cat("Integration Result:", integration_result$value, "\n")
cat("CDF of W2 at 0:", fw2_cdf(0), "\n")
# Verification: These should ideally be very close
cat("Difference:", integration_result$value-fw2_cdf(0) )
integration_result <- integrate(f, -Inf, Inf, rel.tol = 1e-10, abs.tol = 1e-12, subdivisions = 200L)
integration_result
