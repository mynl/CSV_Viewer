py_run_string("
from aggregate import build
import numpy as np
beta, alpha, M, N = 2, 8, 10, 30
port = build(f'''
port Ex32
agg X1 1 claim sev {beta} * expon splice [0 {M}] fixed
agg X2 1 claim sev {beta} * expon splice [0 {M}] fixed
agg X3 1 claim sev {beta} * gamma [1 {alpha}] wts [0.5 0.5] splice [0 {N}] fixed
''')
")
# more python manipulation
py_run_string("
# Densities
bit_r = port.density_df.loc[:50].filter(regex='^p_').reset_index().rename(columns={'index': 'x'}).to_dict(orient='list')
# Allocations
df_alloc = port.make_comonotonic_allocations()
df_alloc.columns = [c.replace('exeqa_', '') for c in df_alloc.columns]
alloc_r = df_alloc.reset_index().rename(columns={'index': 'loss'}).to_dict(orient='list')
")
# 2. Access the 'port' object in R via 'py$port'
density_df_raw<- py$port$density_df
df_density <- as.data.frame(py$bit_r_ready)
df_density <- as.data.frame(py$bit_r)
df_density %>%
pivot_longer(-x, names_to = "unit", values_to = "density") %>%
ggplot(aes(x = x, y = density, color = unit)) +
geom_line() +
theme_minimal()
# 2. Plot Allocations (X1 Example)
df_alloc <- as.data.frame(py$alloc_r_ready)
# 2. Plot Allocations (X1 Example)
